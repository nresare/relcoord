# Example relcoord configuration.

listen = "0.0.0.0"
port = 8080
log-level = "INFO"
detect-deployment = false

# Shared system repository. For non-system requests, its "plugins" subdirectory
# is passed to manifest-builder alongside the config directory's own plugins.
# The latest commit on main is used, and its hash is recorded on the generated
# manifests commit as "<repository>@<commit>".
#
# System-mode requests are not affected. Their config comes from a repository
# that already carries the plugins it needs, so this repository is left out of
# those.
system-repository = "https://github.com/example/system"

[[output]]
name = "example-dev"
repository = "https://github.com/example/manifests"
directory = "example-dev"
# How relcoord reaches the cluster this output is deployed to. This must be
# explicit when deployment detection is enabled: "eks" uses ambient AWS
# credentials; "local" uses the service account of relcoord's own cluster.
connection-type = "eks"
api-endpoint = "https://EXAMPLEDEVCLUSTERID.gr7.eu-west-1.eks.amazonaws.com"
ca-path = "/etc/relcoord/example-dev-ca.pem"
# Region to sign the EKS token in. Defaults to the region of relcoord's own AWS
# session.
region = "eu-west-1"
# Defaults to the output name.
eks-cluster-name = "example-dev"

[output.vars]
cluster_name = "example-dev"
account_id = 111122223333
issuer = "https://oidc.eks.eu-west-1.amazonaws.com/id/EXAMPLEDEVCLUSTERID"

# The manifest-builder target this output generates, for a config repository
# whose top-level config.toml says version = 2. Defaults to the output name,
# which is what "example-dev" above relies on. Config repositories that declare
# config blocks directly are generated with [output.vars] instead, so an output
# serving both kinds of repository configures both.
[[output]]
name = "example-prod"
repository = "https://github.com/example/manifests"
directory = "example-prod"
target = "prod"
connection-type = "eks"
api-endpoint = "https://EXAMPLEPRODCLUSTERID.gr7.eu-west-1.eks.amazonaws.com"
ca-path = "/etc/relcoord/example-prod-ca.pem"
region = "eu-west-1"

[output.vars]
cluster_name = "example-prod"
account_id = 444455556666
issuer = "https://oidc.eks.eu-west-1.amazonaws.com/id/EXAMPLEPRODCLUSTERID"

# The order the outputs above are deployed in. Each stage is pushed and then
# waited for, so example-prod is only deployed once the change has been observed
# in example-dev. An output a change does not affect generates nothing, so it is
# skipped rather than waited for: a change only example-prod is built from finds
# the first stage empty and reaches example-prod straight away.
#
# Every output has to appear in exactly one stage of one rollout, and rollouts
# require detect-deployment = true, since a stage waits for what it pushed.
# Without any [[rollout]], every output is deployed at once and detection runs in
# the background, which is what a deployment that wants no ordering configures.
#
# [[rollout]]
# name = "linear"
#
# [[rollout.stage]]
# outputs = ["example-dev"]
#
# [[rollout.stage]]
# outputs = ["example-prod"]

# EKS connections sign a presigned STS GetCallerIdentity URL as relcoord's own
# identity, so the cluster needs an access entry for relcoord's IAM role, and
# that role may live in another account.
#
# The API endpoint and CA certificate are configured rather than looked up
# because eks:DescribeCluster only resolves clusters in the caller's own
# account. Both are printed by, in the cluster's own account:
#
#   aws eks describe-cluster --name example-dev \
#     --query 'cluster.{endpoint:endpoint,ca:certificateAuthority.data}'
#
# The CA is base64 in that output; ca-path points at the decoded PEM.

[persistence]
backend = "surrealdb"
uri = "ws://localhost:8000"
namespace = "default"
database = "relcoord"

[persistence.idmouse]
url = "http://localhost:9000/token/relcoord"
token-path = "/tmp/idmouse-bearer-token"

# Alternative DynamoDB persistence backend. The table needs string keys pk and sk.
#
# [persistence]
# backend = "dynamodb"
# table-name = "relcoord-image-versions"
# region-name = "eu-west-2"
# endpoint-url = "http://localhost:8000"

[idcat]
endpoint = "https://idcat.example.com"
github-app = "deployments"
token-path = "/tmp/idcat-bearer-token"

# Bearer-token authentication for write endpoints. Each [[role]] entry
# describes one acceptable JWT issuer. A request to /v1/image-versions,
# /v1/change or /v1/diffcomment must present a Bearer token that validates
# against at least one role. Read endpoints (/healthz, /v1/images/latest) are
# not authenticated.

[[role]]
name = "kubernetes-default"
audience = "relcoord"
issuer = "https://kubernetes.default.svc"
jwks-uri = "https://kubernetes.default.svc/openid/v1/jwks"

# Set allow_system = true to permit this role to make system-mode change or
# diffcomment requests (payloads with "system": true), which read config from
# the repository root and generate manifests as the 'system' owner across all
# namespaces and cluster-scoped directories. Defaults to false.
allow_system = false

[role.claims]
sub = "system:serviceaccount:default:default"
